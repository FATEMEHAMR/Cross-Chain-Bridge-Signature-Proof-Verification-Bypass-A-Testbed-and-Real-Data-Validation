# این فایل را به نام .env کپی کنید و مقادیر واقعی را بگذارید.
# .env خودش در .gitignore است و نباید commit شود.

# RPC آرشیوی mainnet (Alchemy پلن رایگان کافی است). از ایران معمولاً VPN لازم است.
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# کلید API اتراسکن (رایگان) — برای اسکریپت جمع‌آوری تراکنش‌های مشروع
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
